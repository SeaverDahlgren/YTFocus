{
  "name": "YTFocus",
  "description": "Turns YouTube into a subscriptions-first, no-recommendations experience.",
  "version": "0.1.0",
  "manifest_version": 3,
  "permissions": [
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "shared-config.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "YTFocus"
  }
}
